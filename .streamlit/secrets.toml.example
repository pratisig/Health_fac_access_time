# Secrets — ne jamais committer le fichier réel `.streamlit/secrets.toml`.
#
# Copier ce modèle :
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# Sur Streamlit Community Cloud : Settings → Secrets.
# Sur Hugging Face Spaces      : Settings → Variables and secrets.
# En local ou sur Render/Railway : variables d'environnement de même nom.

# Clé openrouteservice. Gratuite sur https://openrouteservice.org/dev/#/signup
# Obligatoire pour le mode 2 avec l'API publique.
ORS_API_KEY = "votre-cle-openrouteservice"

# Instance openrouteservice à utiliser.
# Par défaut : https://api.openrouteservice.org (API publique HeiGIT), qui
# plafonne les isochrones motorisées à 60 minutes. Pointer vers une instance
# dédiée pour obtenir réellement les seuils de 70 à 120 minutes.
# ORS_BASE_URL = "https://ors.mon-domaine.org/ors"

# Répertoire de cache persistant (rasters WorldPop, isochrones).
# Hugging Face Spaces avec disque persistant : "/data/cache".
# HEALTH_ACCESS_CACHE_DIR = "/data/cache"
